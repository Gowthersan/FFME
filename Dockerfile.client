# Stage 1: Build Angular application
FROM node:20-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy common folder first (needed for @common/* imports)
COPY common ./common

# Copy client package files
COPY client/package.json client/pnpm-lock.yaml ./client/

# Install dependencies
WORKDIR /app/client
RUN pnpm install --frozen-lockfile

# Copy client source code
WORKDIR /app
COPY client ./client

# Build the application with docker configuration
WORKDIR /app/client
RUN pnpm ng build --configuration docker

# Stage 2: Serve with Node.js
FROM node:20-alpine AS production

WORKDIR /app

# Install serve globally (handles SPA routing automatically)
RUN npm install -g serve

# Copy built files from builder stage
COPY --from=builder /app/client/dist/client ./dist

# Expose port 80
EXPOSE 80

# Start serve on port 80 with SPA support
CMD ["serve", "-s", "dist", "-l", "80"]
